# Copy this file to .env and fill in the credentials from SMS Gate.
SMS_USERNAME=your-sms-gate-username
SMS_PASSWORD=your-sms-gate-password

# Cloud or local Nimbus LGU API.
NIMBUS_API_URL=http://127.0.0.1:8080/api

# Development-only LGU login for PAGASA synchronization.
NIMBUS_LGU_USERNAME=demo
NIMBUS_LGU_PASSWORD=nimbusdemo26

# Legacy demo town codes to synchronize from PAGASA.
NIMBUS_SYNC_CODES=0412,0517,0837,1374

# Webhook signing key from the SMS Gateway app on the gateway phone:
# Settings > Webhooks > Signing Key. The relay rejects unsigned webhooks.
SMS_WEBHOOK_SIGNING_KEY=

# Shared secret for the K signature on NIMBUS SMS replies. Generate one with
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
# and build the app with --dart-define=NIMBUS_SMS_SIGNING_KEY=<same value>.
NIMBUS_SMS_SIGNING_KEY=

# Optional reply limits (defaults shown).
# RELAY_MAX_PER_NUMBER_10MIN=5
# RELAY_MAX_PER_NUMBER_DAY=30
# RELAY_MAX_GLOBAL_HOUR=300
# RELAY_MAX_GLOBAL_DAY=2000
